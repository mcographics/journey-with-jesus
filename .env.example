# Build-time path prefix used by the GitHub Pages project site.
NEXT_PUBLIC_BASE_PATH=/journey-with-jesus

# Safe public client configuration. Leave blank until a Supabase project is created.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional Cloudflare Turnstile public site key for Studio Magic Link CAPTCHA.
# Set as a GitHub Actions repository variable for the production static build.
# The matching SECRET key is configured only in Supabase Auth > Bot and Abuse Protection.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
