# Build-time path prefix used by the GitHub Pages project site.
NEXT_PUBLIC_BASE_PATH=/journey-with-jesus

# Safe public client configuration. Leave blank until a Supabase project is created.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Cloudflare Turnstile public site key for Studio Magic Link sign-in.
# The corresponding SECRET key is configured only in Supabase Auth > Bot and Abuse Protection.
# Do not enable server-side CAPTCHA until the site key is in the production build.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
